    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  let text = item.json.bodyPreview || '';\n\n  const cut = text.search(/(От:|From:|Отправлено:|Sent:)/);\n  if (cut > 20) text = text.slice(0, cut).trim();\n\n  return {\n    json: {\n      from: item.json.from || '',\n      subject: item.json.subject || '',\n      text: text.trim()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "9ade815d-a9bf-42b5-988d-508b2eab7c68",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "=define",
        "text": "=Извлеки данные коммерческого предложения из письма.\n\nОтправитель: {{ $json.from }}\n\nТекст письма:\n{{ $json.text }}\n\nВерни ТОЛЬКО JSON, без пояснений и без markdown-разметки:\n{\"поставщик\":\"\", \"цена_за_единицу\":0, \"валюта\":\"KZT\", \"количество\":0, \"срок_поставки_дней\":0, \"условия_оплаты\":\"\", \"комментарий\":\"\"}\n\nЕсли поле не указано — поставь null.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        832,
        0
      ],
      "id": "b109bf49-b09d-4a50-ac90-0539557b4794",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-haiku-4-5-20251001",
          "mode": "list",
          "cachedResultName": "Claude Haiku 4.5"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.5,
      "position": [
        768,
        208
      ],
      "id": "61bc05f8-f476-4fd0-b259-95f55fe9eec0",
      "name": "Anthropic Chat Model",
      "credentials": {
        "anthropicApi": {
          "id": "YOUR_ANTHROPIC_CREDENTIAL_ID",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = [];\n\nfor (const item of $input.all()) {\n  let raw = item.json.text || '';\n  raw = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n  try {\n    rows.push(JSON.parse(raw));\n  } catch (e) {\n    rows.push({ поставщик: 'не распознано', комментарий: raw.slice(0, 80) });\n  }\n}\n\nrows.sort((a, b) => (a.цена_за_единицу ?? 1e9) - (b.цена_за_единицу ?? 1e9));\n\nconst cells = rows.map((r, i) => `<tr>\n<td>${i + 1}</td>\n<td>${r.поставщик ?? '—'}</td>\n<td>${r.цена_за_единицу ?? '—'}</td>\n<td>${r.количество ?? '—'}</td>\n<td>${r.срок_поставки_дней ?? '—'}</td>\n<td>${r.условия_оплаты ?? '—'}</td>\n</tr>`).join('');\n\nconst html = `<p>Сравнение КП по запросу RFQ-TEST-001 — ручка шариковая</p>\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\">\n<tr><th>№</th><th>Поставщик</th><th>Цена за ед.</th><th>Кол-во</th><th>Срок, дней</th><th>Оплата</th></tr>\n${cells}\n</table>\n<p>Всего предложений: ${rows.length}. Отсортировано по цене.</p>`;\n\nreturn [{ json: { html, count: rows.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        0
      ],
